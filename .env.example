# ── Market Intelligence Firm — Environment Variables ──
# Copy this to .env and fill in your keys

FRED_API_KEY=YOUR_FRED_KEY_HERE

# ── Alpaca (live/ trading module) ──
# Paper keys: https://app.alpaca.markets -> Paper Trading -> API Keys
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
# Keep "true" for paper trading. Set to "false" ONLY for a live account.
ALPACA_PAPER=true
